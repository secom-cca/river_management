		 + Number of house elevation / 365 + Number of migration / 365
	+ Houses damaged by inundation
	~	house
	~		|

Inflow of damaged houses=Houses damaged by inundation
	~	house
	~		|

Municipality cost=Green infrastructure cost +
	Infrastructure Cost + 
	House elevation cost +
	Migration cost + 
	Drainage investment +
	Paddy dam investment
	~	
	~		|

Annual Paddy dam investment=1e+06
	~	Yen/Year [0,5e+07,1e+06]
	~		|

Upstream percolation=Upstream percolation ratio * Upstream inflow
	~	m3/day
	~		|

Paddy dam ratio=Paddy dam area/(Paddy field ratio*Downstream area)
	~	 [0,1,0.05]
	~		|

Downstream percolation=MAX(MIN(Downstream storage * Downstream percolation ratio,Downstream storage\
		-Evaporation downstream),0)
	~	
	~		|

Drainage=MAX(MIN(Drainage capacity*3600*24, Downstream storage-Evaporation downstream\
		-Downstream percolation-Downstream outflow),0)
	~	m3/day
	~		|

Downstream outflow=MAX(MIN(Downstream outflow ratio * Downstream storage,Downstream storage\
		-Evaporation downstream-Downstream percolation),600000)
	~	m3/day
	~		|

Drainage investment amount=0
	~	Yen [0,1e+10,1e+08]
	~		|

