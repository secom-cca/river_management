Paddy dam area= INTEG (Paddy dam investment / Paddy dam cost per area,
		Downstream area*Paddy field ratio*Initial paddy dam ratio)
	~	ha
	~		|

Initial paddy dam ratio=0.1
	~	 [0,1,0.1]
	~		|

Biodiversity=1 - Coefficient for ecosystem * Dam capacity / ( Forest area storage capacity\
		 + Dam capacity )
	~	
	~	2026/04/08　original: 1 - Coefficient for ecosystem * Dam capacity / Forest area \
		storage capacity
		
		Dam capacity capacity と ( Forest area storage capacity + Dam capacity \
		)の比によって調整することに変更。
	|

Degradation of paddy dam=
	0.05
	~	 [0,0.1,0.01]
	~		|

Daily crop production=
	Paddy field * Paddy field productivity * (1 - Deterioration ratio by heat) * Crop price\
		 * 
	((1 - Paddy dam ratio) + Paddy dam ratio * (1 - Degradation of paddy dam))
	~	Yen
	~		|

Coefficient for ecosystem=
	1
	~	 [0,10,1]
	~		|

Delay of recovery=
	365
	~	day [0,770,1]
	~		|

Outflow of damaged houses=
	MAX(0, MIN(DELAY3(Damaged houses*Recovery ratio,Delay of recovery),Damaged houses))
	~	house
	~		|

Recovery ratio=0.9
	~	 [0,1,0.01]
	~		|

Paddy dam investment=IF THEN ELSE ( Paddy dam ratio < 1 , Annual Paddy dam investment\
		 , 0 )
	~	
	~		|

Inflow of houses in risky area=Houses in inundation risk * Inflow rate of residents
	+ Outflow of damaged houses
	~	house
	~		|

Damaged houses= INTEG (Inflow of damaged houses-Outflow of damaged houses,
		0)
	~	
	~		|

